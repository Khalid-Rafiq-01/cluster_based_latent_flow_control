&READ_PARAMETERS     
ISTART = 80000,   ! Starting iteration
ISTOP =  100000, ! Stopping iteration number
ISAVE =  10000,  ! Iteration number to save (snapshot field)
M =      288,  ! Number of points in x-direction
N =      288,  ! Number of points in y-direction
DT =     0.001,  ! Time step (Good CFL number is around 0.3)
Re =     500.000000, ! Reynolds number (0 - 2000)
LEN =    2.00000,     ! Length of inner domain (dx = LEN/M, dy = LEN/N)
OFFSETX =  1.000000,  ! Offset in x (starts from -OFFSETX,-OFFSETX+LEN)
OFFSETY =  1.000000,  ! Offset in y (starts from -OFFSETY,-OFFSETY+LEN)
MGRIDLEV =  5,        ! Number of grid levels (4 or 5)
COMPUTE_PRESSURE = F,  ! Calculation of pressure field
alpha0 = 15.d0,       ! Initial angle of attack
thickness0 = 0.15d0,  ! Thickness of the airfoil
AEROELASTIC = F,      ! Aeroelastic flag
TWODOF = F,           ! Two dof aeroelasticity
Inertia = 4.18,       ! Moment of inertia (measure of density of solid/density of fluid)
Damp_coeff = 0.D0,       ! Damping coefficient
Spring_const = 5.95721425966, ! Spring constant (specify I and fn) 
PITCHING = F,         ! Pitching flag 
freq_p = 0.19d0,      ! frequency of pitch 
amplitude_p = 0.4d0   ! Amplitude of pitch 
HEAVING = F,          ! Heaving flag
freq_h = 0.19d0,      ! frequency of pitch 
amplitude_h = 0.4d0   ! Amplitude of pitch 
VORTICAL_GUST = F,    ! Gust flag
VG_AMP = 1.0D0        ! Gust amplitude
VG_RADIUS = 0.5D0     ! Gust radius
VG_XLOC = -2.D0       ! Gust x-location
VG_YLOC = 0.D0        ! Gust y-location
GUST = F,             ! Gust flag 
Vg = 0.9d0,           ! Velocity of the gust 
Tg = 10.d0,           ! Time of the gust
tgust = 2.5d0,        ! Time at which the gust starts 
pitch_vel_impulse = F     ! Impulse in pitch velocity of the airfoil 
pitch_acc_impulse = F     ! Impulse in pitch acceleration of the airfoil 
stiff_pitch_impulse = F   ! Impulse in stiffness for pitch dynamics of the airfoil
stiff_heave_impulse = F   ! Impulse in stiffness for heave dynamics of the airfoil
heave_vel_impulse = F     ! Impulse in heave velocity of the airfoil
heave_acc_impulse = F     ! Impulse in heave acceleration of the airfoil
pitch_vel_forcing = F     ! Control in pitch velocity of the airfoil 
pitch_acc_forcing = F     ! Control in pitch acceleration of the airfoil 
stiff_pitch_forcing = F   ! Control in stiffness for pitch dynamics of the airfoil
stiff_heave_forcing = F   ! Control in stiffness for heave dynamics of the airfoil
heave_vel_forcing = F     ! Control in heave velocity of the airfoil
heave_acc_forcing = F     ! Control in heave acceleration of the airfoil
mom_impulse = F       ! Impulse in momentum injection
mom_forcing = T       ! Momentum injection (Default is Schroder forcing)
x_inject = 0.1d0      ! X-Point at which to inject momentum  
y_inject = 0.1d0      ! Y-point at which to inject momentum
time_control_start = 10.d0 ! Time to start momentum injection 
/                    
